{
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/identify.ts", "use": "@vercel/node" }
  ],
  "functions": {
    "api/*.ts": { "runtime": "vercel-node@latest" }
  },
  "rewrites": [
    { "source": "/api/identify", "destination": "/api/identify.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
